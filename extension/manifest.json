{
  "manifest_version": 3,
  "name": "Handsel Mandate · Sandbox",
  "version": "0.4.0",
  "minimum_chrome_version": "116",
  "description": "BlockFlow-bound agent budgets with Base Sepolia ERC-4337 and x402.",
  "permissions": [
    "storage",
    "sidePanel",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Handsel"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_page": "panel.html"
}
